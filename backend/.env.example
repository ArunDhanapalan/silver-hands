# Application Settings
APP_NAME="SilverHands 2.0 API"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api"

# Database Configuration (MongoDB)
# If a local/remote MongoDB instance is running, it connects via Motor async driver.
# If MongoDB is not running, SilverHands automatically uses its built-in resilient in-memory async database fallback.
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="silverhands_db"

# Security & JWT Token Secrets
JWT_SECRET_KEY="silverhands-super-secret-key-change-in-prod-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Intelligence Keys
# Add your Google Gemini API key here for dynamic LLM generation:
GEMINI_API_KEY=""
